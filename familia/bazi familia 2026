<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BaZi · Familia · 2026</title>
<link href="https://fonts.googleapis.com/css2?family=IM+Fell+English:ital@0;1&family=Lato:wght@300;400;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{
  --gold:#c9972a;--gold-l:#e8c46a;--cinnabar:#c0392b;
  --midnight:#0d0a18;--surf2:#1a1628;
  --smoke:#7a6e60;--ash:#cfc0a8;--ash2:#b0a090;
  --fire:#e05a1a;--wood:#4a8c3f;--metal:#7a9bb5;--water:#2c5f8a;--earth:#9c7a3c;
  --bdr:rgba(201,151,42,0.18);
  --guadi:#c06090;--morena:#5a9abf;--carla:#7a9b6a;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{background:var(--midnight);color:var(--ash);font-family:'Lato',sans-serif;font-size:16px;line-height:1.7;overflow-x:hidden;}
body::before{content:'';position:fixed;inset:0;z-index:-1;
  background:radial-gradient(ellipse at 20% 10%,rgba(192,96,144,0.05) 0%,transparent 45%),
  radial-gradient(ellipse at 80% 90%,rgba(90,154,191,0.05) 0%,transparent 45%),var(--midnight);}

nav{position:sticky;top:0;z-index:200;background:rgba(13,10,24,0.97);backdrop-filter:blur(12px);border-bottom:1px solid var(--bdr);display:flex;align-items:center;padding:0 1.5rem;overflow-x:auto;gap:0;}
.nav-logo{font-family:'IM Fell English',serif;font-size:1rem;color:var(--gold);padding:1rem 1.2rem 1rem 0;border-right:1px solid var(--bdr);margin-right:0.8rem;white-space:nowrap;flex-shrink:0;}
.nav-tab{padding:0.85rem 1rem;font-family:'Space Mono',monospace;font-size:0.6rem;letter-spacing:0.1em;color:var(--smoke);text-transform:uppercase;cursor:pointer;border:none;background:transparent;border-bottom:2px solid transparent;transition:color 0.2s,border-color 0.2s;white-space:nowrap;}
.nav-tab:hover{color:var(--ash);}
.nav-tab.active{color:var(--gold-l);border-bottom-color:var(--gold);}
.nav-tab.g-tab.active{color:var(--guadi);border-bottom-color:var(--guadi);}
.nav-tab.m-tab.active{color:var(--morena);border-bottom-color:var(--morena);}
.nav-tab.c-tab.active{color:var(--carla);border-bottom-color:var(--carla);}
.nav-sep{width:1px;height:22px;background:var(--bdr);margin:0 0.2rem;flex-shrink:0;}
.nav-back{color:rgba(201,151,42,0.5);font-size:0.55rem;}
.nav-back:hover{color:var(--gold);}

.section{display:none;animation:fadeUp 0.3s ease;}
.section.active{display:block;}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}

.page-header{text-align:center;padding:2.5rem 2rem 1.8rem;border-bottom:1px solid var(--bdr);position:relative;overflow:hidden;}
.page-header::before{content:attr(data-g);position:absolute;right:2rem;top:1rem;font-size:5rem;opacity:0.04;font-family:serif;pointer-events:none;}
.page-header.guadi-hdr::before{color:var(--guadi);}
.page-header.morena-hdr::before{color:var(--morena);}
.page-header.carla-hdr::before{color:var(--carla);}
.eyebrow{font-family:'Space Mono',monospace;font-size:0.6rem;letter-spacing:0.45em;color:var(--gold);text-transform:uppercase;margin-bottom:0.7rem;}
.page-header h1{font-family:'IM Fell English',serif;font-size:clamp(1.7rem,4vw,2.6rem);font-weight:400;line-height:1.15;}
.page-header h1.gc{color:var(--guadi);}
.page-header h1.mc{color:var(--morena);}
.page-header h1.cc{color:var(--carla);}
.page-header p{margin-top:0.4rem;color:var(--smoke);font-style:italic;font-size:0.95rem;}
.badge{display:inline-block;margin-top:0.8rem;padding:0.35rem 1.2rem;font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:0.18em;border-radius:2px;}
.badge.gb{border:1px solid var(--guadi);color:var(--guadi);}
.badge.mb{border:1px solid var(--morena);color:var(--morena);}
.badge.cb{border:1px solid var(--carla);color:var(--carla);}

.ctx-bar{display:flex;justify-content:center;gap:1.8rem;flex-wrap:wrap;padding:0.85rem 2rem;background:rgba(201,151,42,0.03);border-bottom:1px solid var(--bdr);font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:0.07em;color:var(--smoke);}
.ctx-bar.gc span{color:var(--guadi);}
.ctx-bar.mc span{color:var(--morena);}
.ctx-bar.cc span{color:var(--carla);}

.carta-wrap{max-width:980px;margin:0 auto;padding:2.5rem 1.5rem 4rem;}
.sec-title{font-family:'IM Fell English',serif;font-size:1.4rem;font-weight:400;margin:2.2rem 0 0.4rem;padding-bottom:0.5rem;border-bottom:1px solid var(--bdr);}
.sec-title.gt{color:var(--guadi);}
.sec-title.mt{color:var(--morena);}
.sec-title.ct{color:var(--carla);}
.sec-sub{font-size:0.88rem;color:var(--smoke);font-style:italic;margin-bottom:1.3rem;line-height:1.6;}

.pilares-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:1px solid var(--bdr);border-radius:4px;overflow:hidden;margin-bottom:1.8rem;}
.pilar-col{padding:1rem 0.8rem;border-right:1px solid var(--bdr);text-align:center;}
.pilar-col:last-child{border-right:none;}
.pilar-col.hl-g{background:rgba(192,96,144,0.05);}
.pilar-col.hl-m{background:rgba(90,154,191,0.05);}
.pilar-label{font-family:'Space Mono',monospace;font-size:0.53rem;letter-spacing:0.1em;color:var(--smoke);text-transform:uppercase;margin-bottom:0.6rem;}
.pilar-cn{font-size:2.2rem;line-height:1;margin-bottom:0.25rem;}
.pilar-cn.gc{color:var(--guadi);}
.pilar-cn.mc{color:var(--morena);}
.pilar-name{font-size:0.87rem;color:var(--ash);margin-bottom:0.1rem;}
.pilar-el{font-family:'Space Mono',monospace;font-size:0.55rem;color:var(--smoke);}
.dios-tag{display:inline-block;margin-top:0.35rem;padding:0.1rem 0.42rem;border-radius:2px;font-family:'Space Mono',monospace;font-size:0.5rem;}
.tag-f{background:rgba(232,88,10,0.13);color:#e87a3a;border:1px solid rgba(232,88,10,0.25);}
.tag-m{background:rgba(74,140,63,0.13);color:#6db860;border:1px solid rgba(74,140,63,0.25);}
.tag-t{background:rgba(156,122,60,0.13);color:#c9a45a;border:1px solid rgba(156,122,60,0.25);}
.tag-me{background:rgba(138,157,181,0.13);color:#a0b4c8;border:1px solid rgba(138,157,181,0.25);}
.tag-a{background:rgba(44,95,138,0.13);color:#5a9abf;border:1px solid rgba(44,95,138,0.25);}

.e-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(255px,1fr));gap:0.85rem;margin-bottom:1.8rem;}
.e-card{background:var(--surf2);border:1px solid var(--bdr);border-radius:4px;padding:1.1rem 1.2rem;position:relative;overflow:hidden;}
.e-card::before{content:'';position:absolute;left:0;top:0;width:3px;height:100%;}
.e-card.fuego::before{background:var(--fire);}.e-card.madera::before{background:var(--wood);}
.e-card.metal::before{background:var(--metal);}.e-card.agua::before{background:var(--water);}
.e-card.tierra::before{background:var(--earth);}
.e-card.ga::before{background:var(--guadi);}
.e-card.ma::before{background:var(--morena);}
.e-card.ca::before{background:var(--carla);}
.e-card-label{font-family:'Space Mono',monospace;font-size:0.54rem;letter-spacing:0.09em;color:var(--smoke);text-transform:uppercase;margin-bottom:0.3rem;}
.e-card h3{font-family:'IM Fell English',serif;font-size:1rem;font-weight:400;margin-bottom:0.28rem;}
.e-card h3.gc{color:var(--guadi);}
.e-card h3.mc{color:var(--morena);}
.e-card h3.cc{color:var(--carla);}
.e-card p{font-size:0.87rem;color:var(--ash2);line-height:1.6;}

.pot-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.8rem;}
.pot-box{padding:1.2rem 1.3rem;border-radius:4px;}
.pot-box.green{background:rgba(45,122,90,0.07);border:1px solid rgba(45,122,90,0.2);}
.pot-box.red{background:rgba(192,57,43,0.07);border:1px solid rgba(192,57,43,0.2);}
.pot-box h3{font-family:'IM Fell English',serif;font-size:1rem;font-weight:400;margin-bottom:0.55rem;}
.pot-box.green h3{color:#6dbf99;}.pot-box.red h3{color:#e08070;}
.pot-box ul{padding-left:1.1rem;}
.pot-box li{font-size:0.87rem;color:var(--ash2);margin-bottom:0.36rem;line-height:1.52;}

.compat-box{background:var(--surf2);border:1px solid var(--bdr);border-radius:4px;padding:1.3rem 1.4rem;margin-bottom:1.8rem;}
.compat-box h3{font-family:'IM Fell English',serif;font-size:1.05rem;font-weight:400;color:var(--gold-l);margin-bottom:0.75rem;}
.compat-row{display:flex;gap:0.55rem;align-items:flex-start;margin-bottom:0.48rem;}
.compat-icon{font-size:0.95rem;flex-shrink:0;margin-top:0.1rem;}
.compat-text{font-size:0.87rem;color:var(--ash2);line-height:1.55;}

/* HOY CARDS */
.hoy-wrap-fam{max-width:980px;margin:0 auto;padding:2rem 1.5rem 4rem;}
.hoy-hero-fam{
  background:rgba(201,151,42,0.03);border:1px solid var(--bdr);border-radius:6px;
  padding:1.8rem 2rem;margin-bottom:1.5rem;
}
.hoy-fecha-fam{font-family:'IM Fell English',serif;font-size:1.3rem;font-weight:400;margin-bottom:0.3rem;}
.hoy-fecha-fam.gc{color:var(--guadi);}
.hoy-fecha-fam.mc{color:var(--morena);}
.hoy-pilar-fam{font-family:'Space Mono',monospace;font-size:0.62rem;color:var(--smoke);letter-spacing:0.1em;margin-bottom:1rem;}
.hoy-pilar-fam span{color:var(--gold-l);}

.hoy-stars-fam{display:flex;gap:3px;margin-bottom:0.5rem;}
.star-fam{width:16px;height:16px;fill:rgba(201,151,42,0.15);}
.star-fam.on{fill:var(--gold);filter:drop-shadow(0 0 3px rgba(201,151,42,0.4));}

.hoy-verdict-fam{font-family:'IM Fell English',serif;font-size:1.1rem;font-weight:400;margin-bottom:0.6rem;}
.vg{color:#6dbf99;}.vy{color:var(--earth);}.vr{color:#e08070;}

.tips-grid-fam{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.5rem;}
.tips-box{padding:1.3rem 1.4rem;border-radius:5px;}
.tips-box.do-box{background:rgba(45,122,90,0.07);border:1px solid rgba(45,122,90,0.2);}
.tips-box.dont-box{background:rgba(192,57,43,0.07);border:1px solid rgba(192,57,43,0.2);}
.tips-box h3{font-family:'IM Fell English',serif;font-size:1rem;font-weight:400;margin-bottom:0.75rem;}
.tips-box.do-box h3{color:#6dbf99;}
.tips-box.dont-box h3{color:#e08070;}
.tips-box ul{list-style:none;padding:0;}
.tips-box li{font-size:0.9rem;color:var(--ash2);padding:0.38rem 0;border-bottom:1px solid rgba(255,255,255,0.04);line-height:1.55;}
.tips-box li:last-child{border-bottom:none;}
.tips-box li strong{color:var(--ash);display:block;font-size:0.82rem;margin-bottom:0.08rem;}

/* Calendar fam */
.cal-wrap{max-width:1100px;margin:0 auto;padding:2rem 1.5rem 4rem;}
.month-sel{display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1.8rem;}
.month-btn{padding:0.5rem 0.95rem;border:1px solid var(--bdr);background:transparent;color:var(--smoke);font-family:'Space Mono',monospace;font-size:0.6rem;letter-spacing:0.07em;cursor:pointer;border-radius:3px;transition:all 0.18s;}
.month-btn:hover{border-color:rgba(201,151,42,0.4);color:var(--ash);}
.month-btn.active.ga{border-color:var(--guadi);color:var(--guadi);background:rgba(192,96,144,0.08);}
.month-btn.active.ma{border-color:var(--morena);color:var(--morena);background:rgba(90,154,191,0.08);}
.month-btn.active.ca{border-color:var(--carla);color:var(--carla);background:rgba(122,155,106,0.08);}
.month-hdr{display:flex;align-items:center;gap:1.2rem;margin-bottom:1.3rem;padding-bottom:0.8rem;border-bottom:1px solid var(--bdr);}
.month-cn{font-size:2.6rem;opacity:0.55;line-height:1;}
.month-cn.gc{color:var(--guadi);}
.month-cn.mc{color:var(--morena);}
.month-info h2{font-family:'IM Fell English',serif;font-size:1.3rem;font-weight:400;}
.month-info h2.gc{color:var(--guadi);}
.month-info h2.mc{color:var(--morena);}
.month-info p{font-size:0.88rem;color:var(--ash2);margin-top:0.2rem;font-style:italic;}
.cal-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(285px,1fr));gap:0.8rem;}
.day-card{background:rgba(255,255,255,0.022);border:1px solid rgba(201,151,42,0.11);border-radius:4px;padding:1rem 1.1rem;position:relative;overflow:hidden;transition:border-color 0.2s,background 0.2s;}
.day-card::before{content:'';position:absolute;left:0;top:0;width:3px;height:100%;}
.day-card.r5::before{background:#2d7a5a;}.day-card.r4::before{background:#4a8c3f;}
.day-card.r3::before{background:#9c7a3c;}.day-card.r2::before{background:#c0602a;}
.day-card.r1::before{background:var(--cinnabar);}
.day-card:hover{border-color:rgba(201,151,42,0.3);background:rgba(255,255,255,0.038);}
.day-card.weekend{opacity:0.62;}
.day-card.today-card{border-color:rgba(201,151,42,0.5);box-shadow:0 0 0 1px rgba(201,151,42,0.18);}
.today-badge{display:inline-block;background:rgba(201,151,42,0.22);color:var(--gold);font-family:'Space Mono',monospace;font-size:0.48rem;letter-spacing:0.1em;padding:0.07rem 0.38rem;border-radius:2px;margin-left:0.35rem;vertical-align:middle;}
.dc-hdr{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:0.5rem;}
.dc-num{font-family:'IM Fell English',serif;font-size:1.5rem;color:var(--gold-l);line-height:1;}
.dc-dow{font-family:'Space Mono',monospace;font-size:0.52rem;color:var(--smoke);letter-spacing:0.07em;margin-top:0.1rem;}
.dc-pilar{text-align:right;font-family:'Space Mono',monospace;font-size:0.54rem;color:var(--smoke);line-height:1.65;}
.dc-stars{display:flex;gap:2px;margin-bottom:0.42rem;}
.star{fill:rgba(201,151,42,0.15);}
.star.on{fill:var(--gold);filter:drop-shadow(0 0 2px rgba(201,151,42,0.4));}
.etag{display:inline-block;padding:0.11rem 0.5rem;border-radius:2px;font-family:'Space Mono',monospace;font-size:0.54rem;letter-spacing:0.06em;font-weight:700;margin-bottom:0.48rem;}
.etag-m{background:rgba(74,140,63,0.16);color:#6db860;border:1px solid rgba(74,140,63,0.26);}
.etag-f{background:rgba(224,90,26,0.16);color:#e87a40;border:1px solid rgba(224,90,26,0.26);}
.etag-t{background:rgba(156,122,60,0.16);color:#c9a45a;border:1px solid rgba(156,122,60,0.26);}
.etag-me{background:rgba(122,155,181,0.16);color:#a0b4c8;border:1px solid rgba(122,155,181,0.26);}
.etag-a{background:rgba(44,95,138,0.16);color:#5a9abf;border:1px solid rgba(44,95,138,0.26);}
.dc-summary{font-size:0.87rem;color:var(--ash2);line-height:1.5;margin-bottom:0.48rem;font-style:italic;}
.fav-row{display:flex;gap:0.42rem;margin-bottom:0.28rem;align-items:flex-start;}
.fav-label{font-family:'Space Mono',monospace;font-size:0.49rem;padding:0.08rem 0.3rem;border-radius:2px;flex-shrink:0;margin-top:0.14rem;letter-spacing:0.04em;}
.lsi{background:rgba(45,122,90,0.22);color:#5aba90;}
.lno{background:rgba(192,57,43,0.22);color:#e07060;}
.fav-text{font-size:0.8rem;color:var(--ash2);line-height:1.42;}

.exp-bar{padding:1rem 1.3rem;background:rgba(201,151,42,0.03);border:1px solid var(--bdr);border-radius:4px;display:flex;align-items:center;gap:0.9rem;flex-wrap:wrap;margin-top:1.2rem;}
.exp-bar p{font-size:0.87rem;color:var(--smoke);flex:1;min-width:180px;}
.exp-btn{padding:0.5rem 1rem;border:1px solid var(--bdr);background:transparent;color:var(--ash);cursor:pointer;font-family:'Space Mono',monospace;font-size:0.58rem;letter-spacing:0.08em;border-radius:3px;transition:all 0.2s;}
.exp-btn:hover{border-color:var(--gold);color:var(--gold-l);}
.exp-btn.primary{border-color:var(--gold);color:var(--gold-l);background:rgba(201,151,42,0.08);}

@media(max-width:620px){
  .pilares-grid{grid-template-columns:repeat(2,1fr);}
  .pot-grid,.tips-grid-fam{grid-template-columns:1fr;}
  .cal-grid{grid-template-columns:1fr;}
}
</style>
</head>
