function mkEvent(date,title,desc,dur=60){
  const s=new Date(date);s.setHours(9,0,0);
  const e=new Date(s);e.setMinutes(e.getMinutes()+dur);
  return `BEGIN:VEVENT\r\nDTSTAMP:${fICS(new Date())}\r\nDTSTART:${fICS(s)}\r\nDTEND:${fICS(e)}\r\nSUMMARY:${title}\r\nDESCRIPTION:${desc.replace(/\n/g,'\\n').replace(/<[^>]+>/g,'')}\r\nORGANIZER:mailto:sanbaoestudio@gmail.com\r\nEND:VEVENT\r\n`;
}
function dl(name,content){const b=new Blob([content],{type:'text/calendar'});const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=name;a.click();URL.revokeObjectURL(a.href);}

function exportarHoyFam(person){
  const p=todayPilares[person];if(!p)return;
  const pData=PERSONS[person];
  const today=getToday();
  const rating=calcRatingFam(p.ti,p.ri,person);
  const title=`BaZi ${'⭐'.repeat(rating)} · ${pData.name} · ${p.tShort} ${p.animal}`;
  const desc=`Dios: ${pData.dios[p.ti]}\nHACER: ${pData.tipsHacer[p.ti].slice(0,3).join(' / ')}\nEVITAR: ${pData.tipsNoHacer[p.ti].slice(0,3).join(' / ')}`;
  dl(`bazi_${person}_hoy.ics`,`BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//BaZi Familia//ES\r\n${mkEvent(today,title,desc)}END:VCALENDAR`);
}
function abrirGCalHoyFam(person){
  const p=todayPilares[person];if(!p)return;
  const pData=PERSONS[person];
  const today=getToday();
  const rating=calcRatingFam(p.ti,p.ri,person);
  const title=encodeURIComponent(`BaZi ⭐${rating} · ${pData.name} · ${p.tShort} ${p.animal}`);
  const det=encodeURIComponent(`Dios: ${pData.dios[p.ti]}\nHACER: ${pData.tipsHacer[p.ti][0]}\nEVITAR: ${pData.tipsNoHacer[p.ti][0]}`);
