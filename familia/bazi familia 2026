}

// NAV
function showSection(id,tab){
  document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('nav .nav-tab').forEach(t=>t.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  if(tab)tab.classList.add('active');
}

function showSubSection(id,prefix,tab){
  document.querySelectorAll(`.sub-section.${prefix}`).forEach(s=>s.style.display='none');
  const el=document.getElementById(id);
  if(el)el.style.display='block';
  // Update sub-nav tabs
  const parentSection=el.closest('.section');
  if(parentSection){
    parentSection.querySelectorAll('.nav-tab').forEach(t=>{
      t.style.borderBottomColor='transparent';
      t.style.color='';
    });
    if(tab){
      const isG=prefix==='g-';
      tab.style.borderBottomColor=isG?'var(--guadi)':'var(--morena)';
      tab.style.color=isG?'var(--guadi)':'var(--morena)';
    }
  }
}

