const CHOQUES_G=[[0,6],[1,7],[2,8],[3,9],[4,10],[5,11]];
const COMBHE_G=[[0,1],[2,11],[3,10],[4,9],[5,8],[6,7]];
const DESTRUCT_G=[[0,7],[1,6],[2,5],[3,4],[8,11],[9,10]];

function getIntsFam(ri,person){
  const p=PERSONS[person];
  const refs=[...p.natal,p.anioR,p.dayunR];
  let res=[];
  for(let b of refs){
    for(let[a,c]of CHOQUES_G)if((ri===a&&b===c)||(ri===c&&b===a))res.push({tipo:'choque',efecto:'mal',txt:`Choque con ${ANIMALES[b]}`});
    for(let[a,c]of COMBHE_G)if((ri===a&&b===c)||(ri===c&&b===a))res.push({tipo:'combo',efecto:'bien',txt:`Combina con ${ANIMALES[b]}`});
    for(let[a,c]of DESTRUCT_G)if((ri===a&&b===c)||(ri===c&&b===a))res.push({tipo:'dest',efecto:'cuidado',txt:`Destructor con ${ANIMALES[b]}`});
  }
  if(person==='morena'&&(ri===2||ri===6||ri===10))res.push({tipo:'trio',efecto:'bien',txt:'Trío de Fuego completo'});
  return res;
}

function calcRatingFam(ti,ri,person){
  const p=PERSONS[person];let s=3;
  if(p.elemBon.includes(ti))s+=1.0;
  if(p.elemBad.includes(ti))s-=1.1;
  for(let i of getIntsFam(ri,person)){
    if(i.efecto==='bien')s+=0.5;
    if(i.efecto==='mal')s-=0.8;
    if(i.efecto==='cuidado')s-=0.35;
    if(i.tipo==='trio')s+=0.7;
  }
  return Math.max(1,Math.min(5,Math.round(s)));
}

function renderStarsFam(n,sz=12,cls='star'){
