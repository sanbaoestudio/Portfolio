  window.open(`https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&dates=${ds}T090000/${ds}T100000&details=${det}&add=sanbaoestudio%40gmail.com`,'_blank');
}
function exportarMesFam(person){
  const m=currentMonths[person];
  const md=MONTHS_DATA.find(x=>x.m===m);
  const nextM=m===12?1:m+1;const nextY=m===12?2027:2026;
  const nextMd=m===12?{solar:6}:MONTHS_DATA.find(x=>x.m===nextM);
  const start=new Date(`2026-${String(m).padStart(2,'0')}-${String(md.solar).padStart(2,'0')}T12:00:00`);
  const end=new Date(`${nextY}-${String(nextM).padStart(2,'0')}-${String((nextMd?.solar||6)-1).padStart(2,'0')}T12:00:00`);
  const pData=PERSONS[person];
  let events='';
  for(let d=new Date(start);d<=end;d.setDate(d.getDate()+1)){
    const p=getPilar(new Date(d));
    const rating=calcRatingFam(p.ti,p.ri,person);
    const title=`BaZi ${'⭐'.repeat(rating)} · ${pData.name} · ${ELEM_NAME[p.ti]} · ${p.tShort} ${p.animal}`;
    const desc=`Rating: ${rating}/5\nDios: ${pData.dios[p.ti]}\nHACER: ${getCardDoFam(p.ti,person)}\nEVITAR: ${getCardDontFam(p.ti,person)}`;
    events+=mkEvent(new Date(d),title,desc,30);
  }
  dl(`bazi_${person}_${md.name.toLowerCase()}.ics`,`BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//BaZi Familia//ES\r\nCALNAME:BaZi ${pData.name} ${md.name}\r\n${events}END:VCALENDAR`);
}
